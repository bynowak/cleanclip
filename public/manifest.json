{
  "manifest_version": 3,
  "name": "CleanClip — Copy with clarity",
  "version": "1.0.0",
  "description": "Clean copied text locally. Keep paragraphs, headings, lists and tables as plain text, Markdown or safe rich text.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CleanClip · automatic cleaning off",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "clean-selection": {
      "suggested_key": { "default": "Alt+Shift+C", "mac": "Alt+Shift+C" },
      "description": "Clean and copy the current page selection"
    },
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+V", "mac": "Alt+Shift+V" } }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self' data:; style-src 'self'"
  }
}
